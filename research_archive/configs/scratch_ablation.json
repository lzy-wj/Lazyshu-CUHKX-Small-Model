{
  "name": "scratch_ablation_v1",
  "architecture_policy": ["CNN", "RNN", "Transformer"],
  "random_initialization_only": true,
  "fold": 0,
  "seed": 42,
  "epochs": 60,
  "batch_size": 24,
  "frames": 16,
  "image_size": 160,
  "lr": 0.001,
  "workers": 4,
  "eval_every": 2,
  "patience": 60,
  "gpus": [2, 3, 7],
  "jobs": [
    {"name": "scratch_v1_skeleton_f0", "modalities": ["skeleton"], "fusion": "concat"},
    {"name": "scratch_v1_imu_f0", "modalities": ["imu"], "fusion": "concat"},
    {"name": "scratch_v1_radar_f0", "modalities": ["radar"], "fusion": "concat"},
    {"name": "scratch_v1_ir_f0", "modalities": ["scene_ir"], "fusion": "concat"},
    {"name": "scratch_v1_thermal_f0", "modalities": ["thermal"], "fusion": "concat"},
    {"name": "scratch_v1_depth_f0", "modalities": ["scene_depth"], "fusion": "concat"},
    {"name": "scratch_v1_concat_f0", "modalities": ["scene_ir", "thermal", "scene_depth", "skeleton", "imu", "radar"], "fusion": "concat"},
    {"name": "scratch_v1_transformer_f0", "modalities": ["scene_ir", "thermal", "scene_depth", "skeleton", "imu", "radar"], "fusion": "transformer"}
  ],
  "selection": "Fold 0 exploratory screening only; no automatic fold 1, refit, model replacement or Kaggle submission",
  "radar": "Temporal CNN over existing point-cloud frame statistics; spatial-grid CNN deferred",
  "augmentation": "Existing mild clip-consistent brightness/translation and sensor noise; no mixup, flips, pretrained crops or feature caches"
}
